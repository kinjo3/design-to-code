{
	"description": "外部サイトとの通信を許可する design-diff の実行は、auto mode でも人の承認画面に回す。承認した宛先はセッションの間だけ覚える",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/design-approval.mjs\"" }]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/design-approval.mjs\"" }]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "Bash",
				"hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/design-approval.mjs\"" }]
			}
		]
	}
}
